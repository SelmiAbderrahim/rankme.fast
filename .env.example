# Root .env is the single source of truth. Never create .env files in subdirectories.
# Consumed by `docker compose` at compose-time AND by the `api` runtime container.

# Runtime
NODE_ENV=production
# Production rejects every PROVIDER_*=fake selector (and EMAIL_TRANSPORT=fake)
# unless this explicit CI/demo escape hatch is true. Keep false for real
# deployments and configure live provider selectors below.
ALLOW_FAKE_PROVIDERS=false
PORT=8080
LOG_LEVEL=info

# Host port for the `web` container (Node SSR server — server.js, listens on 3000).
WEB_PORT=3000

# Databases / queues — service hostnames resolve on the compose `rankme` network.
MONGODB_URI=mongodb://mongo:27017/rankme
REDIS_URL=redis://redis:6379

# Job layer — the `worker` service consumes the BullMQ `audits`
# and `ranks` queues. WORKER_CONCURRENCY = jobs processed concurrently per
# queue worker (I/O-bound vendor calls; default 5). WORKER_PORT = the
# container-internal /healthz port used by the compose healthcheck (never
# published to the host).
WORKER_CONCURRENCY=5
WORKER_PORT=8081

# Postgres — relational, ordered time-series data (rank history, keywords,
# backlinks, competitors, subscriptions, usage counters). Mongo stays the
# default document store. POSTGRES_* provision the compose `postgres` service;
# DATABASE_URL is what the api and worker actually connect with —
# keep the credentials in sync. Generate the password: openssl rand -hex 16
POSTGRES_USER=rankme
POSTGRES_PASSWORD=replace-me-with-a-random-hex-string
POSTGRES_DB=rankme
DATABASE_URL=postgres://rankme:replace-me-with-a-random-hex-string@postgres:5432/rankme
# postgres-js pool size per process. Default 10 (both api and worker).
PG_POOL_MAX=10

# ===========================================================================
# Auth (Better Auth) — sessions, password hashing, CSRF, and OAuth state are
# vetted library code; the secret signs session tokens. REQUIRED, >= 32 chars.
# Generate: openssl rand -hex 32
# ===========================================================================
BETTER_AUTH_SECRET=replace-me-with-a-random-64-char-hex-string
# Google OAuth (social sign-in) — OPTIONAL. The provider is only registered
# when BOTH values are present; email+password works without them.
# Console: https://console.cloud.google.com/apis/credentials — authorize
# <SERVER_URL>/api/auth/callback/google as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs
CLIENT_URL=http://localhost:3000
# Authenticated app origin. Leave equal to CLIENT_URL for single-origin/local deployments.
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:8080
# Public repository URL listed in /llms.txt (https only). Blank omits the link.
# Keep it in sync with VITE_GITHUB_URL; forks may point both at their own repository.
GITHUB_REPOSITORY_URL=https://github.com/SelmiAbderrahim/rankme.fast

# i18n — optional. Server-side default locale when Accept-Language and cookie/override are missing.
# Must be one of: en, ar, fr, de, es, ru, zh. Defaults to `en`.
DEFAULT_LOCALE=en

# Client build-time (Vite) — same-origin `/api` goes through the web→api
# reverse proxy and keeps the browser CSP at `connect-src 'self'`. If you set
# an absolute API or socket URL, the web server derives that origin into
# `connect-src` at boot.
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
# Public origin of the site — used to build absolute canonical / Open Graph /
# hreflang / sitemap URLs for the server-rendered marketing pages. No trailing slash.
VITE_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID (safely serialized into index.html at build).
# Leave blank to ship without GA; the guarded bootstrap makes no
# analytics request unless the value is a valid `G-...` ID. Changes require a rebuild.
VITE_GA_ID=
# Public GitHub repository URL. Drives the GitHub link, AGPL license badge,
# `git clone` line, and the beta banner's "Report a bug" issue form. Blank hides
# every open-source element and sends bug reports to the support mailbox. Forks
# may point it at their own repository. Baked into the client bundle at build
# time; changes require a rebuild.
VITE_GITHUB_URL=https://github.com/SelmiAbderrahim/rankme.fast
# Release stage shown in the shared chrome: `beta` renders the public-beta
# banner and header badge on marketing and app surfaces; `ga` removes both.
# Blank or any other value resolves to `beta`. Baked into the client bundle at
# build time; changes require a rebuild.
VITE_RELEASE_STAGE=beta
# Internal origin of the api service, used by the web SSR server (server.js) to
# reverse-proxy /robots.txt and /sitemap*.xml. In Docker: http://api:8080.
API_INTERNAL_URL=http://localhost:8080
# Web-container-only: upstream fetch timeout for the AI Assistant SSE stream
# proxy route (chat message POSTs). Read by client/server.js, never by the
# api's env schema. Default 300000 (5 minutes).
#PROXY_STREAM_TIMEOUT_MS=300000

# ===========================================================================
# Encryption — REQUIRED. Fails startup if missing or decodes to < 32 bytes.
# ===========================================================================
# The AES-256-GCM master key that encrypts secrets at rest. Accepted encodings
# are tried in order: hex, base64, utf8. The first encoding
# that yields >= 32 bytes wins; only the first 32 bytes are used as the AES-256
# key.
#
# WARNING: Losing this key = every ciphertext in Mongo becomes unrecoverable.
# Back it up out-of-band. Rotation runbook: server/src/shared/crypto/README.md
#
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace-me-with-a-random-64-char-hex-string

# ===========================================================================
# Email (Resend) — OPTIONAL. Self-host installs boot without these.
# ===========================================================================
EMAIL_TRANSPORT=resend
# Isolated Playwright only. Captures fake messages in a bounded 0600 /tmp file
# inside the API container; never enable with a real email transport.
E2E_EMAIL_CAPTURE=false
RESEND_API_KEY=
RESEND_FROM=
# Recipient inbox for /api/contact form submissions. If unset, deliverContactForm
# falls back to RESEND_FROM; if both are unset the send throws so misconfig fails
# loudly instead of dropping mail into a black hole.
CONTACT_FORM_RECIPIENT=

# Optional. When set, `sendFailureAlert` POSTs the alert payload to this URL
# in addition to the Resend email.
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Secrets live in THIS file (root .env) — set the real values on the
# RESEND_API_KEY lines above. There is NO Docker-secret `_FILE` mechanism:
# an empty mounted secret file used to silently override a valid .env value
# when it was empty, so it was removed. Keep .env gitignored.
# ---------------------------------------------------------------------------


# ===========================================================================
# Security & legal — OPTIONAL with production-safe defaults.
# ===========================================================================
# Auth-route rate-limiter: window + max requests per IP inside the window.
# Counts credential mutations (POST sign-in/sign-up/reset) only; read-only
# GET /api/auth/get-session is exempt so normal browsing never exhausts it.
# Defaults: 30 requests / 15 minutes.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
# Webhook rate-limiter: applied BEFORE HMAC verification so a flood cannot
# waste CPU on signature math. Defaults: 120 / minute (~2 rps sustained).
# Admin-overview aggregation window for `rate_limit_hits` — the rolling
# window over which the admin panel counts 429 responses per route.
# Widen for slow-burn campaigns; default: 1 hour.
RATE_LIMIT_METRICS_WINDOW_MS=3600000
# Public read-only API (/api/v1) rate limiter: window + max requests per
# API key (sha256 of the bearer token; falls back to source IP when no key
# is presented). Defaults: 120 requests / minute.
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
# Public immutable report shares: every request is limited per IP before token
# lookup, then live tokens receive a separate proven-digest bucket.
RATE_LIMIT_REPORT_EXPORT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_REPORT_EXPORT_PUBLIC_IP_MAX=60
RATE_LIMIT_REPORT_EXPORT_PUBLIC_TOKEN_MAX=120
# Public contact-sales endpoint (/api/enterprise-leads).
# Strict per-IP: unauthenticated, and each accepted request stores a lead and
# sends an email.
RATE_LIMIT_ENTERPRISE_LEAD_WINDOW_MS=3600000
RATE_LIMIT_ENTERPRISE_LEAD_MAX=5
# Contact-form limiter — per-IP on /api/communication/contact so a spam
# relay looping the endpoint hits 429 before any Resend spend. Defaults: 5
# requests / 15 minutes.
RATE_LIMIT_CONTACT_WINDOW_MS=900000
RATE_LIMIT_CONTACT_MAX=5
# Intelligence-expansion named buckets. Account-keyed unless noted.
RATE_LIMIT_CONTENT_CREATE_WINDOW_MS=60000
RATE_LIMIT_CONTENT_CREATE_MAX=10
# Content Intelligence read/poll bucket — GET list + GET detail (bounds
# 404-probing / status hammering). Per-account. Defaults: 60 / minute.
RATE_LIMIT_CONTENT_POLL_WINDOW_MS=60000
RATE_LIMIT_CONTENT_POLL_MAX=60
RATE_LIMIT_RECOMMENDATION_WINDOW_MS=60000
RATE_LIMIT_RECOMMENDATION_MAX=60
RATE_LIMIT_INVENTORY_WINDOW_MS=60000
RATE_LIMIT_INVENTORY_MAX=5
RATE_LIMIT_COMPETITOR_WINDOW_MS=60000
RATE_LIMIT_COMPETITOR_MAX=30
# Link Intelligence mutations — shared per-account bucket for all four deep
# pulls and link-gap starts. Defaults: 30 requests / minute.
RATE_LIMIT_LINK_INTEL_WINDOW_MS=60000
RATE_LIMIT_LINK_INTEL_MAX=30
# Link Intelligence stored-result reads — separate per-account poll bucket so
# polling cannot exhaust mutation capacity. Defaults: 60 requests / minute.
RATE_LIMIT_LINK_INTEL_POLL_WINDOW_MS=60000
RATE_LIMIT_LINK_INTEL_POLL_MAX=60
# Traffic Insights snapshot mutations — per account, 10 requests / minute.
RATE_LIMIT_TRAFFIC_SNAPSHOTS_WINDOW_MS=60000
RATE_LIMIT_TRAFFIC_SNAPSHOTS_MAX=10
# Review Intelligence mutation bucket (source CRUD + sync submits), per account.
RATE_LIMIT_REVIEW_SYNC_WINDOW_MS=60000
RATE_LIMIT_REVIEW_SYNC_MAX=20
# Brand Radar: paid scan creation vs stored-scan polling, both
# keyed per account so a polling client cannot lock itself out of its data.
RATE_LIMIT_BRAND_RADAR_CREATE_WINDOW_MS=60000
RATE_LIMIT_BRAND_RADAR_CREATE_MAX=10
RATE_LIMIT_BRAND_RADAR_POLL_WINDOW_MS=60000
RATE_LIMIT_BRAND_RADAR_POLL_MAX=60
# Firecrawl webhook is pre-auth and keyed by source IP.
RATE_LIMIT_FIRECRAWL_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_FIRECRAWL_WEBHOOK_MAX=120
# MCP uses a proven bearer-token digest with source-IP fallback.
RATE_LIMIT_MCP_WINDOW_MS=60000
RATE_LIMIT_MCP_MAX=120
# AI Assistant chat bucket — per-account; every /api/chat route counts. Each
# message POST opens an SSE stream and reserves an ai_chat_messages unit, so
# the bucket is deliberately tight. Defaults: 20 requests / minute.
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_SUPERADMIN_WINDOW_MS=60000
RATE_LIMIT_SUPERADMIN_MAX=60
# CSRF double-submit cookie + header names. Both default to `x-csrf-token`.
CSRF_COOKIE_NAME=x-csrf-token
CSRF_HEADER_NAME=x-csrf-token
# Account-deletion grace period (hours). Purge is queued this many hours
# after the delete request; the final Resend warning fires 24h before purge.
# Default: 30 days.
ACCOUNT_DELETION_GRACE_HOURS=720

# ===========================================================================
# Vendor providers. Deterministic fakes are available to test/demo
# stacks only. With NODE_ENV=production and ALLOW_FAKE_PROVIDERS=false, every
# fake selector below fails startup until it is replaced by a shipped live
# adapter. Unknown/unshipped values also fail startup loudly.
# ===========================================================================
# DataForSEO Basic-auth credentials (https://app.dataforseo.com/api-access).
#DATAFORSEO_LOGIN=
#DATAFORSEO_PASSWORD=
# Prod: https://api.dataforseo.com/v3 (default). Sandbox is a free drop-in
# swap serving dummy data: https://sandbox.dataforseo.com/v3
#DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3
# Per-capability selection: dataforseo|fake (audit/rank/keyword/backlink/
# competitor/local listings), dataforseo|google|fake (pagespeed), and
# google|fake (gsc, ga4). Default: fake.
#PROVIDER_AUDIT=fake
#PROVIDER_RANK=fake
#PROVIDER_KEYWORD=fake
#PROVIDER_BACKLINK=fake
#PROVIDER_COMPETITOR=fake
# Local SEO Business Data API listings/reviews/Q&A provider. Default: fake.
PROVIDER_LOCAL_LISTINGS=fake
#PROVIDER_PAGESPEED=fake
#PROVIDER_GSC=fake
#PROVIDER_GA4=fake
# Summary migration modes: fake (deterministic profile), anthropic (legacy
# single-provider AI SDK profile), ai-sdk (ordered audit_summary profile).
# Unknown values fail startup.
#PROVIDER_SUMMARY=fake
# AI Visibility — DataForSEO AI Optimization API (LLM Mentions,
# LLM Responses, AI Keyword Search Volume). dataforseo|fake. Default: fake.
#PROVIDER_AI_VISIBILITY=fake
# Content Analysis — DataForSEO Content
# Analysis (`search/live` + `summary/live`). Seam only in this batch; Brand
# Radar consumes it. dataforseo|fake. Default: fake.
#PROVIDER_CONTENT_ANALYSIS=fake
# Reviews — DataForSEO Business Data reviews
# for Google/Trustpilot/Tripadvisor. Seam only in this batch; Review
# Intelligence consumes it. dataforseo|fake. Default: fake.
#PROVIDER_REVIEWS=fake
# Google Trends — DataForSEO
# `keywords_data/google_trends/explore/live`. Seam only in this batch; Keyword
# Trends consumes it. dataforseo|fake. Default: fake.
#PROVIDER_TRENDS=fake
# App Data + Labs mobile-store research provider. Store (google_play|app_store)
# is selected per operation, not here. dataforseo|fake. Default: fake.
#PROVIDER_APP_DATA=fake
# Content source: deterministic fake by default; Firecrawl v2 Cloud only.
# The key is required only when PROVIDER_CONTENT_SOURCE=firecrawl. The base URL
# is operator configuration fixed to the Cloud origin; self-hosted endpoints
# and user-editable endpoints are unsupported.
PROVIDER_CONTENT_SOURCE=fake
FIRECRAWL_API_KEY=
# Optional ordered, comma-separated failover credentials (maximum 5). Every
# configured account must have Firecrawl Cloud ZDR enabled. Never commit keys.
FIRECRAWL_FALLBACK_API_KEYS=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=60000
FIRECRAWL_MAX_PAGE_CHARS=100000
FIRECRAWL_MAX_CRAWL_PAGES=100
# Estimated internal cost per reported Firecrawl credit, in bigint micros.
FIRECRAWL_COST_MICROS_PER_CREDIT=1000
# Operator attestation that EVERY Firecrawl Cloud account configured above has
# Zero Data Retention enabled (Enterprise ZDR entitlement). Adapter still
# sends zeroDataRetention:true on every request; without this attestation env
# validation refuses to construct the live provider. Strict "true"|"false"
# — anything else (or empty) resolves to false and blocks live selection.
FIRECRAWL_ZDR_ENABLED=false
# Firecrawl monitor webhook authentication (Agency page change monitoring).
# MIGRATION: FIRECRAWL_WEBHOOK_SECRET and FIRECRAWL_WEBHOOK_SECRETS are retained
# as bounded, redacted legacy inputs but no longer authorize deliveries. Before
# deploying this release, create FIRECRAWL_WEBHOOK_SECRET_BINDINGS with exactly
# one object for the primary API key and every fallback API key. Each object may
# hold at most current + previous secrets during rotation. A secret is globally
# unique and can authenticate only its bound Firecrawl account. After rollout,
# remove the two legacy variables from the external deployment secret store.
# Example (one primary + one fallback):
# [{"credential":"primary","secrets":["primary-current","primary-old"]},{"credential":"fallback:0","secrets":["fallback-current"]}]
FIRECRAWL_WEBHOOK_SECRET=
FIRECRAWL_WEBHOOK_SECRETS=
FIRECRAWL_WEBHOOK_SECRET_BINDINGS=
# Content-monitor reconciliation sweep interval (weekly reservation + provider
# drift + stuck-receipt re-enqueue), in milliseconds. Default 5 minutes.
CONTENT_MONITOR_RECON_INTERVAL_MS=300000
ALERT_SWEEP_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Content Intelligence — per-analysis direct-cost ceiling and AI
# sub-budget in micros USD, plus the ContentSnapshot Mongo TTL.
CONTENT_ANALYSIS_COST_CEILING_MICROS=250000
CONTENT_ANALYSIS_AI_BUDGET_MICROS=140000
CONTENT_ANALYSIS_SNAPSHOT_TTL_DAYS=7
# Content inventory + cannibalization — hard operator ceiling on
# the requested owned-page crawl limit (per-run pageLimit clamped to 1..N).
CONTENT_INVENTORY_MAX_PAGES=100

# ---------------------------------------------------------------------------
# Vendor-neutral structured AI generation. fake is deterministic and keyless.
# Live mode tries enabled providers in this unique order; SDK retries are off.
# Model IDs and micro-dollar rates are operator configuration.
PROVIDER_AI=fake
AI_PROVIDER_ORDER=glm,deepseek,kimi,openai,google,anthropic
AI_TOTAL_TIMEOUT_MS=120000
AI_MAX_ATTEMPTS=6
AI_TELEMETRY_ENABLED=false
# Rolling account Cost-DoS circuit breaker and safe usage-event retention.
AI_ACCOUNT_SPEND_WINDOW_MS=3600000
AI_ACCOUNT_SPEND_LIMIT_MICROS=1000000
AI_USAGE_RETENTION_DAYS=90
# AI Assistant streaming chat. Per-message output-token
# ceiling (mirrored by the ai_chat_messages vendor-cost envelope), whole-stream
# wall clock, and the multi-step tool-loop bound.
#AI_CHAT_MAX_OUTPUT_TOKENS=2048
#AI_CHAT_TOTAL_TIMEOUT_MS=120000
#AI_CHAT_MAX_STEPS=5

GLM_ENABLED=false
GLM_API_KEY=
GLM_MODEL=
# Operator-only endpoint. SEC-URL requires a public HTTPS URL outside tests.
GLM_BASE_URL=
GLM_INPUT_COST_MICROS_PER_MILLION=
GLM_OUTPUT_COST_MICROS_PER_MILLION=

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_INPUT_COST_MICROS_PER_MILLION=
DEEPSEEK_OUTPUT_COST_MICROS_PER_MILLION=

KIMI_ENABLED=false
KIMI_API_KEY=
KIMI_MODEL=
KIMI_INPUT_COST_MICROS_PER_MILLION=
KIMI_OUTPUT_COST_MICROS_PER_MILLION=

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_COST_MICROS_PER_MILLION=
OPENAI_OUTPUT_COST_MICROS_PER_MILLION=

GOOGLE_ENABLED=false
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
GOOGLE_INPUT_COST_MICROS_PER_MILLION=
GOOGLE_OUTPUT_COST_MICROS_PER_MILLION=

ANTHROPIC_ENABLED=false
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_COST_MICROS_PER_MILLION=
ANTHROPIC_OUTPUT_COST_MICROS_PER_MILLION=

# ---------------------------------------------------------------------------
# Optional AI summary. Every mode uses the versioned audit_summary task profile.
# Feature-flagged: the audit and cached report render identically when this is
# off or failing. anthropic additionally requires ANTHROPIC_API_KEY plus the
# ANTHROPIC_* cost-rate fields above. ai-sdk requires PROVIDER_AI=ai-sdk and
# uses AI_PROVIDER_ORDER after the profile allowlist. Only localized rule copy
# and the site domain are sent; never raw HTML or vendor payloads.
#AI_SUMMARY_ENABLED=false
#ANTHROPIC_API_KEY=
#AI_SUMMARY_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# PageSpeed. `google` supplies PSI lab + CrUX field data and
# requires GOOGLE_API_KEY; `dataforseo` uses the existing DataForSEO
# credentials and supplies Lighthouse lab data only (field data stays absent).
# For Google: enable "PageSpeed Insights API" AND "Chrome UX Report API".
#GOOGLE_API_KEY=
# The audit processor samples the site root URL + up to N top pages by
# centrality (mobile strategy). Bounded 0..3; default 3.
# DataForSEO Lighthouse is $0.005/scanned page.
#PAGESPEED_SAMPLE_SIZE=3
# Cross-user PageSpeed cache TTL (hours). One analyze() per (url, strategy) per
# window serves every account auditing that URL. Default 24.
#PAGESPEED_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Google Search Console — URL Inspection API on connected
# properties. Refresh tokens are stored encrypted with MASTER_ENCRYPTION_KEY.
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from the auth section (do
# NOT create a second OAuth client — duplicate-account risk).
# Quotas: URL Inspection 2000/day and 600/min per property. Sampling ceiling
# below leaves headroom. 0 disables GSC sampling entirely.
#
# Search Analytics (clicks/impressions/CTR/position) + the
# sitemaps list now flow through the SAME provider (PROVIDER_GSC) and the
# same webmasters.readonly scope — no new env vars, no re-consent. The audit
# processor makes two Search Analytics calls + one sitemaps GET per run
# (well inside the 1200/min/property budget) and persists daily snapshots
# in Postgres (gsc_search_analytics / gsc_sitemaps).
#GSC_INSPECT_SAMPLE=10

# ---------------------------------------------------------------------------
# Google Analytics 4 — Data API v1beta (runReport) + Admin API (account
# summaries), selected by PROVIDER_GA4 above. FREE Google quota; the feature
# is Pro+ tier-gated, never metered. Reuses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET via an incremental analytics.readonly grant on the
# SAME OAuth client (no second client — duplicate-account risk).
# GA4 export lag in days — report windows end at today - GA4_LAG_DAYS
# (standard properties finalize within ~24-48h). Default 1.
#GA4_LAG_DAYS=1

# ---------------------------------------------------------------------------
# Keyword research cache. Vendor search-volume + difficulty is
# monthly data — a 30-day TTL is safe and keeps per-lookup cost low. Shorter
# TTLs burn cost for no fresher signal. See docs/keyword-research.<locale>.md.
#KEYWORD_CACHE_TTL_DAYS=30
# Rank-tracking SERP cache and depth. Defaults: 24 hours, top 100 results.
#SERP_CACHE_TTL_HOURS=24
#SERP_DEPTH=100
# Depth for the SYNCHRONOUS live SERP path. Rank checks do NOT use it — they
# take the async task_post/task_get path below — so this bounds only providers
# without that pair. Live bills $0.002/page, hence
# the cap of 30 to stay within the serp_checks unit-cost bound. Default 20.
#SERP_LIVE_DEPTH=20
# Wait budget for DataForSEO's async SERP task queue, which IS the path rank
# checks take. A task still in queue is re-polled at this interval up to this
# many attempts; exhausting them fails that one keyword's check as temporarily
# unavailable (it still consumed a serp_checks unit). Interval x attempts is the
# real budget: 3000 x 60 = 180s by default. Raise the attempts, not the
# interval, if checks fail with "temporarily unavailable" during busy periods.
#SERP_TASK_POLL_INTERVAL_MS=3000
#SERP_TASK_MAX_POLL_ATTEMPTS=60

# ===========================================================================
# Audit pipeline. Vendor does the crawl asynchronously; the
# worker polls until the vendor reports finished OR the overall run deadline
# lapses. Defaults align with DataForSEO guidance.
# ===========================================================================
# Poll cadence for GET /on_page/summary. 30s is a reasonable default.
#AUDIT_POLL_INTERVAL_MS=30000
# Wall-clock cap for one processor attempt. Retrying past this makes a slow
# vendor no faster — the run is marked failed instead.
#AUDIT_RUN_TIMEOUT_MS=1800000

# ===========================================================================
# SuperAdmin bootstrap (superadmin). Optional platform-owner seed. On every
# api boot an idempotent, async seeder runs: if no account exists for
# SUPERADMIN_EMAIL it is CREATED with the SuperAdmin role; if one already
# exists the seeder skips it. WARNING: this is a bootstrap credential — the
# seeder NEVER overwrites or rotates an existing account, so rotate the
# password from the app after first login. Leave both blank to disable seeding.
# 2FA enrolment is forced on first login before the /superadmin panel opens.
#SUPERADMIN_EMAIL=owner@example.com
#SUPERADMIN_PASSWORD=change-me-at-least-12-chars

# ===========================================================================
# Content Intelligence rollout flags. Default true so a fresh
# boot serves the shipped surface. Flip any of these to false to return the
# localized product-unavailable response on new-run entry points; already
# queued/running jobs finish to a consistent terminal state and existing
# result reads remain available. Superadmin surfaces the resolved values
# read-only. MCP_ENABLED is the matching MCP kill switch.
# ===========================================================================
#MCP_ENABLED=true
# AI Assistant kill switch. Default true. Flip to
# false to return the localized unavailable response on new-message sends
# while conversation reads stay available.
#CHAT_ENABLED=true
# Custom-plan builder master rollout authority. Default off; persistence and
# migrations may ship before preview/checkout routes exist.
# Alert when actual direct cost differs from modeled cost by 10%; stop only
# new custom-plan sales at 25%. Integer parts-per-million, bounded to 1..1m.
#CONTENT_INTELLIGENCE_ENABLED=true
#CONTENT_INVENTORY_ENABLED=true
#COMPETITOR_CONTENT_INTELLIGENCE_ENABLED=true
#COMPETITOR_INTELLIGENCE_ENABLED=true
#CONTENT_MONITORING_ENABLED=true

# ===========================================================================
# rankme-semrush-parity kill switches. All default false — each
# flag is a declared seam that a later prompt reads before serving its
# feature entry points. Flip a flag to true once its owning prompt has
# landed and the operator is ready to expose the feature. Disabling any
# flag returns the localized product-unavailable response on new-run entry
# points; already-queued/running jobs finish to a consistent terminal state
# and existing result reads remain available. Superadmin surfaces the
# resolved values read-only via IntelligenceThresholdsDto.envKillSwitches.
# ===========================================================================
#BRAND_RADAR_ENABLED=false
#REVIEW_INTELLIGENCE_ENABLED=false
#LINK_INTELLIGENCE_ENABLED=false
#TRAFFIC_INSIGHTS_ENABLED=false
#KEYWORD_TRENDS_ENABLED=false

# ===========================================================================
# rankme-community-requests kill switches. All default false —
# each flag is a declared seam that a later prompt reads before serving its
# feature entry points. Flip a flag to true once its owning prompt has landed
# and the operator is ready to expose the feature. Disabling any flag
# returns the localized product-unavailable response on new-run entry
# points; already-queued/running jobs finish to a consistent terminal state
# and existing result reads remain available. Superadmin surfaces the
# resolved values read-only via IntelligenceThresholdsDto.communityKillSwitches.
# ===========================================================================
#SERP_FEATURE_TRACKING_ENABLED=false
#KEYWORD_CLUSTERING_ENABLED=false
#ALT_ENGINE_TRACKING_ENABLED=false
#CANNIBALIZATION_ENABLED=false
#TOXIC_LINKS_ENABLED=false
#ALERTS_ENABLED=false
#INTERNAL_LINKING_ENABLED=false
#CONTENT_BRIEFS_ENABLED=false
#GEOGRID_ENABLED=false
#SCHEMA_GENERATOR_ENABLED=false
#CLIENT_REPORTS_ENABLED=false
#PUBLIC_EXPORTS_ENABLED=false
# Per-run direct-cost ceilings in micros USD. Each mirrors the metric's
# VENDOR_UNIT_COST_MICROS row so the runtime halt and the margin math cite one
# number: content_briefs 120_000, internal_link_runs 12_000,
# toxicity_reviews 30_000, schema_generations 6_000.
#CONTENT_BRIEF_COST_CEILING_MICROS=120000
#INTERNAL_LINKING_COST_CEILING_MICROS=12000
#TOXICITY_COST_CEILING_MICROS=30000
#SCHEMA_GEN_COST_CEILING_MICROS=6000

# ===========================================================================
# rankme-app-seo kill switches. All default false — each flag is a
# declared seam that a later prompt reads before serving its feature entry
# points. APP_SEO_ENABLED is the master switch over app profiles and every
# /api/sites/:siteId/apps/* entry point (the zero-spend cross-store comparison
# view rides it too); the other five gate their own surface underneath it.
# Flip a flag to true once its owning prompt has landed and the operator is
# ready to expose the feature. Disabling any flag returns the localized
# product-unavailable response on new-run entry points; already-queued/running
# jobs finish to a consistent terminal state and existing result reads remain
# available. Superadmin surfaces the resolved values read-only via
# IntelligenceThresholdsDto.appSeoKillSwitches.
# ===========================================================================
#APP_SEO_ENABLED=false
#APP_KEYWORD_TRACKING_ENABLED=false
#APP_LISTING_AUDITS_ENABLED=false
#APP_CHART_TRACKING_ENABLED=false
#APP_RESEARCH_ENABLED=false
#APP_REVIEWS_ENABLED=false
# maxCostMicros for the `app_review_clusters` AI profile. The enforced
# pre-dispatch halt and the app_review_runs unit-cost row cite this one number
# (12 Apple review blocks 18_000 + 40_000 ceiling = the 58_000-micro unit).
#APP_REVIEW_AI_COST_CEILING_MICROS=40000
# ASO named per-account rate buckets. CREATE covers every paid ASO submit
# across the surfaces (one shared bucket so an account cannot fan spend across
# six panels); POLL covers the zero-cost stored reads history charts poll.
#RATE_LIMIT_APP_SEO_CREATE_WINDOW_MS=60000
#RATE_LIMIT_APP_SEO_CREATE_MAX=10
#RATE_LIMIT_APP_SEO_POLL_WINDOW_MS=60000
#RATE_LIMIT_APP_SEO_POLL_MAX=60

# Legacy MERN integrations (optional — leave blank if unused)

# Optional short Git SHA (7–12 hex digits); baked into web/api/worker. Rebuild all three.
APP_BUILD_SHA=dev
# VITE_APP_VERSION= (generated by Vite from client/package.json + APP_BUILD_SHA; do not set it)
